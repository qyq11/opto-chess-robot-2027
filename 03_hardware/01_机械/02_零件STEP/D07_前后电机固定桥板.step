GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#837)) GLOBAL_UNIT_ASSIGNED_CONTEXT
((#834,#835,#836)) REPRESENTATION_CONTEXT('Context #1',
  '3D Context with UNIT and UNCERTAINTY') );
#834 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#835 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#836 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#837 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#834,
  'distance_accuracy_value','confusion accuracy');
#838 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
