<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1936" pageHeight="1840" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="整车供电与线束｜同一电池，并联三条支路" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=34;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="64" y="24" width="1792" height="64" as="geometry"/></mxCell><mxCell id="3" value="蓝框：已付款　橙框：待购 / 待配　｜　每根供电箭头表示一对红+ / 黑−线，不是只接正极。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="64" y="96" width="1792" height="48" as="geometry"/></mxCell><mxCell id="4" value="格氏2S硬壳电池［已付款］&lt;br&gt;7.4V标称 / 8.4V满充 / 7200mAh&lt;br&gt;XT60主放电口；平衡口只用于匹配充电器" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=22;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="168" width="512" height="128" as="geometry"/></mxCell><mxCell id="5" value="总保险F0 + 总开关S0［待购］&lt;br&gt;只串联在正极，负极直接回负母线&lt;br&gt;保险靠近电池；规格见接线表" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=22;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="408" width="512" height="112" as="geometry"/></mxCell><mxCell id="6" value="绝缘分电盒 / 正负母线［待购］&lt;br&gt;＋母线分配动力与稳压输入；−母线共地，所有大电流负线各自回到这里" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=22;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="64" y="632" width="1792" height="112" as="geometry"/></mxCell><mxCell id="7" value="动力支路：F1 + 独立动力停机S1&lt;br&gt;原电池电压直接供驱动&lt;br&gt;不经过RK的5V降压板" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=22;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="64" y="904" width="512" height="128" as="geometry"/></mxCell><mxCell id="8" value="计算支路：F2保险［待购］&lt;br&gt;亚博稳压电源板［已付款］，IN+ / IN−&lt;br&gt;输入≥7V时5V/5A；6V时仅3A" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=21;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="904" width="512" height="128" as="geometry"/></mxCell><mxCell id="9" value="控制支路：F3 + 独立5V稳压［待购］&lt;br&gt;输入覆盖当前2S电池工作范围&lt;br&gt;按F407整板电源口配线，预留1A起" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=21;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="904" width="512" height="128" as="geometry"/></mxCell><mxCell id="10" value="亚博四路驱动［已付款］&lt;br&gt;接DC5V～12V输入端子：红+ / 黑−&lt;br&gt;已含T插→裸线，当前分电方案不必用它&lt;br&gt;驱动辅助5V口仅0.7A，不能供RK" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=21;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="64" y="1200" width="512" height="160" as="geometry"/></mxCell><mxCell id="11" value="泰山派3M + 原配风扇［已付款］&lt;br&gt;Power Type-C输入5V，主板按4A起&lt;br&gt;用明确支持5A的短C-C成品线&lt;br&gt;5A为RK、相机、风扇合计额度" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=21;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="1200" width="512" height="160" as="geometry"/></mxCell><mxCell id="12" value="F407完整板［待购］&lt;br&gt;接该板允许的5V电源输入&lt;br&gt;禁止把电池电压接3V3 / GPIO&lt;br&gt;与驱动UART线不互接5V" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=21;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="1200" width="512" height="160" as="geometry"/></mxCell><mxCell id="13" value="4台310电机，额定7.4V［已付款］&lt;br&gt;每台原配六芯线接对应M1～M4组&lt;br&gt;M±为动力，3V3/GND供编码器" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=21;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="64" y="1520" width="512" height="128" as="geometry"/></mxCell><mxCell id="14" value="USB相机［待购］→ RK USB HOST&lt;br&gt;已购风扇 → RK 5V FAN&lt;br&gt;这两项不再直接接电池" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=21;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="1520" width="512" height="128" as="geometry"/></mxCell><mxCell id="15" value="SPI IMU等低压模块［待购］&lt;br&gt;按模块规格取3.3V或5V + GND&lt;br&gt;电池电压检测另经分压/保护接ADC" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=21;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="1520" width="512" height="128" as="geometry"/></mxCell><mxCell id="16" value="接头与线序：XT60必须与已购电池的实际触点配对；全车红正黑负，所有端子按板上+ / −丝印接。&lt;br&gt;低压与停机：RK电源板输入按≥7.0V安排欠压停车；切断S1只停动力，保留RK与F407供电。图为接线设计，未实物验证。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=19;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="64" y="1680" width="1792" height="80" as="geometry"/></mxCell><mxCell id="17" value="P01 XT60成品取电&lt;br&gt;红+ / 黑−" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="984" y="320" width="224" height="64" as="geometry"/></mxCell><mxCell id="18" value="P02 主电源线&lt;br&gt;红+ / 黑−" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="984" y="544" width="224" height="64" as="geometry"/></mxCell><mxCell id="19" value="P03 动力支路线&lt;br&gt;红+ / 黑−" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="344" y="792" width="224" height="64" as="geometry"/></mxCell><mxCell id="20" value="P05 计算支路线&lt;br&gt;红+ / 黑−" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="984" y="792" width="224" height="64" as="geometry"/></mxCell><mxCell id="21" value="P09 控制支路线&lt;br&gt;红+ / 黑−" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1624" y="792" width="224" height="64" as="geometry"/></mxCell><mxCell id="22" value="P04 端子直接接线&lt;br&gt;无需再降到5V" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="344" y="1084" width="224" height="64" as="geometry"/></mxCell><mxCell id="23" value="P06 短C-C成品线&lt;br&gt;明确支持5A" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="984" y="1084" width="224" height="64" as="geometry"/></mxCell><mxCell id="24" value="P10 5V + GND&lt;br&gt;按整板输入配线" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1624" y="1084" width="224" height="64" as="geometry"/></mxCell><mxCell id="25" value="S04 原配六芯×4&lt;br&gt;同时含编码器反馈" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="344" y="1408" width="224" height="64" as="geometry"/></mxCell><mxCell id="26" value="P07 USB HOST&lt;br&gt;P08 FAN" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="984" y="1408" width="224" height="64" as="geometry"/></mxCell><mxCell id="27" value="P11 模块电源&lt;br&gt;3.3V / 5V按规格" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1624" y="1408" width="224" height="64" as="geometry"/></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;