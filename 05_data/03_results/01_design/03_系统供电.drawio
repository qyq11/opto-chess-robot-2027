<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1504" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="系统供电｜动力与计算两条并联支路" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=32;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="56" as="geometry"/></mxCell><mxCell id="3" value="2026-10-30｜箭头表示正负一对线；实际极性、保护额定与线束需核对，不表示已接通。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1520" height="48" as="geometry"/></mxCell><mxCell id="4" value="已购格氏2S / 7200mAh / XT60&lt;br&gt;标称7.4V，满充8.4V" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="584" y="160" width="384" height="112" as="geometry"/></mxCell><mxCell id="5" value="F0总保险 + S0总开关&lt;br&gt;P01 / P02成品主取电总成" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="584" y="352" width="384" height="112" as="geometry"/></mxCell><mxCell id="6" value="绝缘分电：正母线、负母线分组&lt;br&gt;动力负线直接回分电；不沿RK细信号地回流" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="208" y="544" width="1136" height="112" as="geometry"/></mxCell><mxCell id="7" value="F1动力保险 + S1动力停机&lt;br&gt;P03 / P04动力端子线&lt;br&gt;额定电流按实测与线束锁定" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="208" y="768" width="384" height="128" as="geometry"/></mxCell><mxCell id="8" value="F2计算支路保险&lt;br&gt;P05 → 稳压板IN+ / IN−&lt;br&gt;18AWG为设计预算，待核" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="768" width="384" height="128" as="geometry"/></mxCell><mxCell id="9" value="已购亚博四路驱动&lt;br&gt;动力输入按实物正负端&lt;br&gt;不经过RK的5V稳压" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="208" y="992" width="384" height="128" as="geometry"/></mxCell><mxCell id="10" value="已购亚博Type-C稳压板&lt;br&gt;7–24V输入时标5V / 5A&lt;br&gt;按输入≥7.0V安排欠压停车" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="992" width="384" height="128" as="geometry"/></mxCell><mxCell id="11" value="S03 六芯线×4 → 四台310&lt;br&gt;同时携带动力 / 编码器供电 / A/B&lt;br&gt;四轮低速与停车待实测" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="208" y="1216" width="384" height="128" as="geometry"/></mxCell><mxCell id="12" value="P06 5A短C-C → RK Power口&lt;br&gt;P07/S01相机，P08原配风扇&lt;br&gt;RK与外设合计供电额度需核" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="1216" width="384" height="128" as="geometry"/></mxCell><mxCell id="13" value="P01 / P02&lt;br&gt;主干14AWG设计值" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="992" y="376" width="304" height="72" as="geometry"/></mxCell><mxCell id="14" value="动力支路" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=22;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="208" y="704" width="160" height="40" as="geometry"/></mxCell><mxCell id="15" value="计算支路" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=22;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1184" y="704" width="160" height="40" as="geometry"/></mxCell><mxCell id="16" value="本轮不加STM32。&lt;br&gt;不设专用控制稳压支路。&lt;br&gt;S1断开后RK仍有电：&lt;br&gt;先核串口断电隔离，再测试。&lt;br&gt;不接5V线不等于无反灌。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="624" y="992" width="304" height="176" as="geometry"/></mxCell><mxCell id="17" value="电机动力不从RK排针取电；驱动辅助5V不供RK。串口只接TX / RX / GND，信号连接见图02。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxG