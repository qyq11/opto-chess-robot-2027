  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2056" pageHeight="1224" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="整机系统框架｜按已付款硬件更新" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=34;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="64" y="24" width="1856" height="64" as="geometry"/></mxCell><mxCell id="3" value="蓝框：已付款　橙框：待购 / 待配　｜　图02说明信号与职责，电源线逐段见图03及接线表。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="64" y="104" width="1856" height="48" as="geometry"/></mxCell><mxCell id="4" value="USB UVC相机 ×1［待购］&lt;br&gt;候选：微雪OV4689 A&lt;br&gt;原有ESP32用OV5640不直接接RK" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="64" y="176" width="320" height="128" as="geometry"/></mxCell><mxCell id="5" value="六轴IMU ×1［待购］&lt;br&gt;SPI + DRDY&lt;br&gt;按模块规格供电" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="576" y="176" width="320" height="128" as="geometry"/></mxCell><mxCell id="6" value="固定采购基线：&lt;br&gt;格氏2S / 7.4V / 7200mAh / XT60&lt;br&gt;泰山派3M 4G+64G + 原配散热&lt;br&gt;四路驱动 + 四台310 + 65mm尼龙轮" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=22;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1088" y="176" width="832" height="144" as="geometry"/></mxCell><mxCell id="7" value="泰山派3M［已付款］&lt;br&gt;RK3576 · 4GB + 64GB&lt;br&gt;采集 / 识别 / 定位 / 决策&lt;br&gt;独立5V供电，非电池直连" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="64" y="448" width="320" height="192" as="geometry"/></mxCell><mxCell id="8" value="F407完整板 ×1［待购］&lt;br&gt;运动学 / IMU / 失联停车&lt;br&gt;两组UART分别接RK与驱动&lt;br&gt;整板型号与引脚待锁定" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="576" y="448" width="320" height="192" as="geometry"/></mxCell><mxCell id="9" value="亚博四路编码器驱动［已付款］&lt;br&gt;RX2 / TX2 / GND 接F407&lt;br&gt;协处理器采编码器、做轮速PID&lt;br&gt;M1～M4分别接四台310" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1088" y="448" width="320" height="192" as="geometry"/></mxCell><mxCell id="10" value="310编码器电机 ×4［已付款］&lt;br&gt;额定7.4V · 减速1:20 · 13线&lt;br&gt;M1左前 / M2左后&lt;br&gt;M3右前 / M4右后" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="448" width="320" height="192" as="geometry"/></mxCell><mxCell id="11" value="泰山派原配散热［已付款］&lt;br&gt;接主板5V FAN专用接口&lt;br&gt;不接电池，不接电机驱动" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="64" y="816" width="320" height="128" as="geometry"/></mxCell><mxCell id="12" value="碰撞×2 / 电压采样×1［待购］&lt;br&gt;GPIO输入 / 分压滤波后ADC&lt;br&gt;电池正极不能直接接ADC" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="576" y="816" width="320" height="128" as="geometry"/></mxCell><mxCell id="13" value="激光及受控驱动［待购］&lt;br&gt;≤1mW、II类；按赛题核定&lt;br&gt;GPIO只控开关，不直接带负载" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1088" y="816" width="320" height="128" as="geometry"/></mxCell><mxCell id="14" value="65mm尼龙麦轮 / 3mm六角毂&lt;br&gt;T5X四驱碳板2套［均已付款］&lt;br&gt;先装1片主底板，绝缘固定板卡" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="816" width="320" height="128" as="geometry"/></mxCell><mxCell id="15" value="接线原则：RK与F407、F407与驱动均为TX↔RX交叉 + GND；各板分别供电，串口线不互接5V。&lt;br&gt;编码器只接四路驱动板；310原配每台一套六芯线同时携带M±、3V3/GND、A/B，F407不再直采8路A/B。&lt;br&gt;RK UART物理针号 / Linux节点、F407完整板引脚与逻辑电平仍待核；本图为设计连接，不表示实物已接通。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="64" y="1016" width="1856" height="128" as="geometry"/></mxCell><mxCell id="16" value="S01 USB HOST&lt;br&gt;视频 + 5V供电" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#334155;fontSize=18;fontFamily=Microsoft YaHei;align=left;ve