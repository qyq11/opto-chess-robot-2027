<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="952" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="系统信号连接｜RK40针串口直连驱动" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=32;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="56" as="geometry"/></mxCell><mxCell id="3" value="2026-10-30｜蓝框为已购；橙框为后续待配。当前未完成本车电气与运动验收。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1520" height="48" as="geometry"/></mxCell><mxCell id="4" value="车载相机（待选）&lt;br&gt;固定孔 / 配套支架 / 线缆&lt;br&gt;清晰度与RK连接待验证" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="40" y="240" width="272" height="176" as="geometry"/></mxCell><mxCell id="5" value="泰山派3M RK3576&lt;br&gt;视觉、决策、四轮速度换算&lt;br&gt;限速 / 加减速 / 串口反馈&lt;br&gt;本轮不加STM32" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="432" y="240" width="304" height="176" as="geometry"/></mxCell><mxCell id="6" value="亚博四路驱动&lt;br&gt;编码器计数、四轮轮速PID&lt;br&gt;收四轮速度 / 回传轮速&lt;br&gt;串口断线停车能力待核" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="864" y="240" width="272" height="176" as="geometry"/></mxCell><mxCell id="7" value="四台310编码器电机&lt;br&gt;M1左前 / M2左后&lt;br&gt;M3右前 / M4右后&lt;br&gt;用户报告已装配，电气待测" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E8F2FF;strokeColor=#2563A6;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1256" y="240" width="304" height="176" as="geometry"/></mxCell><mxCell id="8" value="S01&lt;br&gt;按实际接口" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=16;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="328" y="160" width="144" height="72" as="geometry"/></mxCell><mxCell id="9" value="S02 UART&lt;br&gt;115200 / 8N1&lt;br&gt;TX / RX / GND" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=16;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="744" y="152" width="152" height="80" as="geometry"/></mxCell><mxCell id="10" value="S03 六芯线×4&lt;br&gt;动力 + 编码器" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=16;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1144" y="160" width="152" height="72" as="geometry"/></mxCell><mxCell id="11" value="后续IMU / 触点 / 激光等&lt;br&gt;S04–S07按需求接RK&lt;br&gt;电平、驱动、供电与针位待核&lt;br&gt;首轮不接，不增加STM32" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF5E5;strokeColor=#A56822;strokeWidth=2;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="432" y="584" width="304" height="160" as="geometry"/></mxCell><mxCell id="12" value="兼容SPI / I²C / GPIO&lt;br&gt;核对复用后再接入" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="608" y="472" width="232" height="72" as="geometry"/></mxCell><mxCell id="13" value="落地前必须闭合的缺口&lt;br&gt;RK卡死或串口断线后如何独立停车？&lt;br&gt;不把RK退出回调当作整机故障保护。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="864" y="584" width="664" height="144" as="geometry"/></mxCell><mxCell id="14" value="接线：RK TX→驱动RX2，RK RX←驱动TX2，GND共地；串口5V线悬空绝缘。&lt;br&gt;物理针位、电平、Linux节点及一侧失电防反灌待实物核对；编码器只接驱动，不直接接RK计数脚。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#142C46;fontSize=20;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="40" y="792" width="1520" height="80" as="geometry"/></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#315C86;strokeWidth=2;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#315C86;strokeWidth=2;endArrow=open;endFill=0;endSize=12;startArrow=open;startFill=0;startSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#315C86;strokeWidth=2;endArrow=open;endFill=0;endSize=12;startArrow=open;startFill=0;startSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#315C86;strokeWidth=2;endArrow=open;endFill=0;endSize=12;startArrow=open;startFill=0;startSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="5" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel>
